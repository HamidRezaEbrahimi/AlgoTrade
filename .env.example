# ========================================
# AlgoTrade — Environment Variables
# ========================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control!

# ── Trading Mode ──────────────────────────
# Options: PAPER_TRADING (default), LIVE_TRADING, BACKTEST
TRADING_MODE=PAPER_TRADING

# ── Exchange: Wallex (والکس) ──────────────
WALLEX_API_KEY=your_wallex_api_key
WALLEX_SECRET=your_wallex_secret

# ── Exchange: Nobitex (نوبیتکس) ───────────
NOBITEX_API_KEY=your_nobitex_api_key
NOBITEX_SECRET=your_nobitex_secret

# ── Faraz API (Forex / TSE Data) ──────────
FARAZ_API_DOMAIN_1=https://sourcearena.ir
FARAZ_API_DOMAIN_2=https://farazapi.com
FARAZ_API_DOMAIN_3=https://api.farazapi.ir
FARAZ_API_TOKEN=

# ── Database (PostgreSQL) ─────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=algotrade
DB_USER=algotrade
DB_PASSWORD=changeme_strong_password
DB_URL=postgresql+asyncpg://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# ── Redis (Cache & Pub/Sub) ───────────────
REDIS_URL=redis://localhost:6379/0

# ── API Server ────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173

# ── Authentication (Multi-User) ──────────
JWT_SECRET_KEY=generate_a_strong_random_secret_here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Telegram Bot ──────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_IDS=123456789,987654321

# ── Bale Bot (بله) ───────────────────────
BALE_BOT_TOKEN=your_bale_bot_token
BALE_CHAT_IDS=123456789

# ── Logging ───────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=./logs

# ── Language ──────────────────────────────
DEFAULT_LOCALE=fa

# ── Encryption Key (for stored API keys) ──
ENCRYPTION_KEY=generate_a_32_byte_fernet_key_here
